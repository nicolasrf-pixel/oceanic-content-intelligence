{
  "name": "oceanic-content-intelligence",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "vite build --config web/vite.config.ts",
    "deploy": "npm run build && wrangler deploy",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "test": "vitest run",
    "db:create": "wrangler d1 create oceanic-content-db",
    "r2:create": "wrangler r2 bucket create oceanic-content-media",
    "db:migrate:local": "wrangler d1 migrations apply oceanic-content-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply oceanic-content-db --remote",
    "db:seed:local": "wrangler d1 execute oceanic-content-db --local --file=seed/seed.sql",
    "db:seed:remote": "wrangler d1 execute oceanic-content-db --remote --file=seed/seed.sql"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261119.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8",
    "wrangler": "^4.20.0"
  }
}
